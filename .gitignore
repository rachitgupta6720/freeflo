# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
env/

# Build output: py2app's scratch + bundle, and the compiled speech helper
# (build/freeflo-helper, from scripts/build_helper.sh)
build/
dist/

# Third-party binaries dropped in for a local build (e.g. vendor/llama-server
# for Turbo mode — see README "Building")
vendor/

# Model files are never committed (Turbo's .gguf is downloaded on demand)
*.bin
*.gguf

# Google OAuth client baked into the build (holds the client secret) — never commit
google_client.json

# Telemetry keys (PostHog project key + Sentry DSN) baked into the build — never commit
telemetry.json

# macOS
.DS_Store

# Editors
.idea/
.vscode/
*.swp
